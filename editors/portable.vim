" Selected settings recovered from vimrc.txt.
filetype on
filetype plugin on
filetype indent on
syntax on
set number
set cursorline
set shiftwidth=4
set tabstop=4
set expandtab
set scrolloff=10
set incsearch
set ignorecase
set smartcase
set showmatch
set hlsearch
set wildmenu
set wildmode=list:longest
